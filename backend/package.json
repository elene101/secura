{
  "name": "secura-ge-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/server.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "set-password": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/set-password.js",
    "test": "node --test",
    "check-mail": "node --env-file-if-exists=.env scripts/check-mail.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.15.0"
  }
}
