PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
SMSOFFICE_KEY=
SMS_SENDER=SecuraGE
ADMIN_EMAILS=you@example.com

# PAYMENT_MODE=disabled for public beta. demo is for private development.
PAYMENT_MODE=demo
# მხოლოდ PAYMENT_MODE=bog-ისთვის:
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
PUBLIC_API_URL=https://api.შენი-დომენი.ge
FRONTEND_URL=https://შენი-დომენი.ge

# GitHub-ით შესვლა (github.com/settings/developers -> New OAuth App)
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# უცხოეთის ნომრებზე SMS-ისთვის (Twilio). ქართულ ნომრებზე SMSoffice მუშაობს
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Account and monitoring email. Choose smtp or resend.
MAIL_TRANSPORT=smtp
# For Gmail SMTP use smtp.gmail.com, port 465, and a Google App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESEND_API_KEY=

# ---- უსაფრთხოება (production-ისთვის) ----
# NODE_ENV=production        # ჩართავს მკაცრ რეჟიმს: HSTS, secure cookies, დემო გადახდა აიკრძალება
# TRUST_PROXY=1              # მხოლოდ მაშინ, როცა სერვერი proxy-ს უკანაა (nginx, Cloudflare), სხვაგვარად IP-ების გაყალბება შეიძლება
# ALLOW_DEMO_PAYMENTS=1      # production-ში დემო გადახდას მხოლოდ პირად ტესტზე ნუ ჩართავ
# EXTRA_ORIGINS=https://www.shen-saiti.ge   # დამატებითი დაშვებული საიტები (მხოლოდ თუ საიტი სხვა მისამართიდანაც იხსნება)

# Optional features
DATA_SECRET=
SUPPORT_EMAIL=
BACKUP_DIR=
GOOGLE_WEB_RISK_KEY=
TELEGRAM_BOT_TOKEN=
MONITOR_PEER_URL=
MONITOR_PEER_KEY=
MONITOR_PEER_ACCEPT=0
MONITOR_WORKER_ONLY=0
